{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-d1-sync-v1",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-d1-sync",
      "migrations_dir": "migrations","database_id": "a6d263e7-6ea6-493a-a2a5-552f485c9aed"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "secrets": {
    "required": [
      "MASTER_KEY"
    ]
  }
}
